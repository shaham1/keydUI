{
  "configurations": [
    {
      "name": "Linux",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/frontend/linux/flutter/ephemeral",
        "${workspaceFolder}/frontend/linux/flutter/ephemeral/flutter_linux",
        "${workspaceFolder}/frontend/linux/runner",
        "/usr/include/gtk-3.0",
        "/usr/include/pango-1.0",
        "/usr/include/glib-2.0",
        "/usr/lib/x86_64-linux-gnu/glib-2.0/include",
        "/usr/include/harfbuzz",
        "/usr/include/freetype2",
        "/usr/include/cairo",
        "/usr/include/gdk-pixbuf-2.0",
        "/usr/include/gio-unix-2.0",
        "/usr/include/atk-1.0"
      ],
      "defines": [
        "APPLICATION_ID=\"com.keydui.app\"",
        "GDK_WINDOWING_X11"
      ],
      "compilerPath": "/usr/bin/g++",
      "cStandard": "c11",
      "cppStandard": "c++14",
      "intelliSenseMode": "linux-gcc-x64"
    }
  ],
  "version": 4
}

